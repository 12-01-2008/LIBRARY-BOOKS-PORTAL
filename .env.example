# ========================================================
# BiblioSphere - Smart Library Book Availability Portal
# Environment Configuration Template
# ========================================================

# Port for Express server in standalone production mode
PORT=3000

# --------------------------------------------------------
# Supabase Configuration
# --------------------------------------------------------

# 1. Supabase Project URL (Used by both backend and client)
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Supabase Anonymous / Public Key (Safe for frontend client)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# 3. Supabase Service Role Key (CRITICAL: Used ONLY by Node.js backend. NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-private-key"
